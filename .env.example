# ─────────────────────────────────────────────────────────────
# PAKO VENDEDOR — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# ─────────────────────────────────────────────────────────────

# ── META WHATSAPP BUSINESS API ──────────────────────────────
# Token permanente de la app "Pako APK" (ID: 2199333980797645)
# Generarlo en: Meta Business Suite → Configuración → Usuarios del sistema → Generar token
META_TOKEN=your_permanent_meta_token_here

# Phone Number ID del número 981 220 039 (el de PAKO)
META_PHONE_ID=1467502383103842

# Token de verificación del webhook (puedes dejar este valor o cambiarlo)
WEBHOOK_VERIFY_TOKEN=pako_apk_2024

# ── ANTHROPIC API ────────────────────────────────────────────
# Crear cuenta en console.anthropic.com y generar API key
# OJO: esta es una clave DISTINTA a tu suscripción de Claude
ANTHROPIC_API_KEY=sk-ant-...

# ── NOTION ──────────────────────────────────────────────────
# Token de integración de Notion (ya lo tienes del Nutritor)
NOTION_TOKEN=secret_...

# ID de la base de Leads en Notion
NOTION_DB_ID=2ee9af5d941d8124a435000bc2ebe6c8

# ── SERVIDOR ─────────────────────────────────────────────────
# Railway lo asigna automáticamente — no tocar en producción
PORT=8000
